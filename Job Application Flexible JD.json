    {
      "parameters": {
        "jsCode": "// Get the output text from the AI Agent node\nconst aiText = $input.item.json.output;\n\nlet parsedData = {};\ntry {\n  // Try to parse the text directly into a valid JSON object\n  parsedData = JSON.parse(aiText);\n} catch (e) {\n  // If the text contains markdown formatting or extra text, extract the JSON block using regex\n  const jsonMatch = aiText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsedData = JSON.parse(jsonMatch[0]);\n  }\n}\n\n// Return the parsed data structured so Supabase can map each key to its separate column\nreturn [{ json: parsedData }];"
      },
      "type": "n8n-nodes-base.code",
