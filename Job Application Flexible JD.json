    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert HR recruiter and data parser. Read the following raw CV text carefully.\n\nHere is the Job Description / Requirements we are looking for:\n{{ $('Get a row').first().json.job_requirements }}\n\nPlease evaluate the CV against these requirements and output the result strictly in valid JSON format with the following keys:\n- \"fname\": Full Name\n- \"email\": Email address\n- \"skills\": All technical and soft skills extracted as a clean list\n- \"experience\": Professional work history\n- \"education\": Degrees and university details\n- \"project\": Notable projects\n- \"courses\": Training courses or certifications\n- \"score\": A numeric score from 0 to 100 based on how well the candidate matches the Job Description requirements\n- \"summary\": A brief executive summary explaining the evaluation and why this score was given\n- \"links\": \"Extract all URLs, portfolio links, GitHub, or LinkedIn links found anywhere in the text. Return them as a comma-separated string. If absolutely no URLs are found, return 'No professional links provided'.\n- \"language\": \"Extract all spoken or written languages mentioned in the CV. If none are explicitly written, look at the primary language of the CV text itself (e.g., if the CV is written in English, write 'English') or return 'Not specified' - NEVER return null.\n\nCV Text:\n{{ $('Extract from File').item.json.text }}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -1312,
        336
      ],
      "id": "12838818-7aeb-4b09-b9e7-626d3767e0b6",
