    {
      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'Upload_CV');\nconst pdfRaw = buffer.toString('latin1');\n\nconst uriRegex = /\\/URI\\s*\\(([^)]+)\\)/g;\nconst linksSet = new Set();\nlet match;\n\nwhile ((match = uriRegex.exec(pdfRaw)) !== null) {\n  const url = match[1]\n    .replace(/\\\\\\(/g, '(')\n    .replace(/\\\\\\)/g, ')')\n    .replace(/\\\\\\\\/g, '\\\\')\n    .trim();\n  if (url) linksSet.add(url);\n}\n\nreturn [{\n  json: {\n    ...$json,\n    detectedLinks: linksSet.size\n      ? Array.from(linksSet).join(', ')\n      : 'No professional links provided'\n  },\n  binary: $input.item.binary\n}];"
      },
