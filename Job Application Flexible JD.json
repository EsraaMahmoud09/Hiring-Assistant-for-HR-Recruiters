      "parameters": {
        "jsCode": "// Get candidate data from the previous node\nconst candidate = $input.item.json;\n\nlet linksHtml = \"No professional links provided\";\n\nif (candidate.links) {\n    if (Array.isArray(candidate.links)) {\n        linksHtml = candidate.links.join(' , ');\n    } else {\n        linksHtml = candidate.links;\n    }\n}\n\nreturn {\n    json: {\n        ...candidate,\n        linksHtml: linksHtml\n    }\n};"
      },
